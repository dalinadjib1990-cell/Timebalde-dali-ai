# GEMINI_API_KEY: Primary Gemini AI API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Multi-Key Auto-Rotation Pool (Configurable on Vercel / Cloud Run / Local):
# Add multiple keys to automatically rotate on rate limits (429/503/quota)
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# Or comma-separated list of keys:
# GEMINI_API_KEYS="AIzaSy...,AIzaSy...,AIzaSy..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
